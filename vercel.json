{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/what-is-geo/ai-visibility-strategy",
      "destination": "/ai-visibility-strategy",
      "permanent": true
    },
    {
      "source": "/what-is-geo/arm-framework",
      "destination": "/arm-framework",
      "permanent": true
    },
    {
      "source": "/what-is-geo/seo-for-ai-brands",
      "destination": "/seo-for-ai-brands",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/llms-full.txt"
    },
    {
      "source": "/.well-known/security.txt",
      "destination": "/security.txt"
    },
    {
      "source": "/sitemap",
      "destination": "/sitemap/index.html"
    },
    {
      "source": "/glossary",
      "destination": "/glossary/index.html"
    },
    {
      "source": "/glossary/arm-primitives",
      "destination": "/glossary/arm-primitives/index.html"
    },
    {
      "source": "/glossary/entity-authority",
      "destination": "/glossary/entity-authority/index.html"
    },
    {
      "source": "/glossary/resonance-bft-agent-swarms",
      "destination": "/glossary/resonance-bft-agent-swarms/index.html"
    },
    {
      "source": "/glossary/share-of-model",
      "destination": "/glossary/share-of-model/index.html"
    },
    {
      "source": "/glossary/signal-architecture",
      "destination": "/glossary/signal-architecture/index.html"
    },
    {
      "source": "/glossary/signal-decay",
      "destination": "/glossary/signal-decay/index.html"
    },
    {
      "source": "/multi-agent-hardware",
      "destination": "/multi-agent-hardware/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "site.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "llms.txt",
      "use": "@vercel/static"
    },
    {
      "src": "llms-full.txt",
      "use": "@vercel/static"
    },
    {
      "src": "security.txt",
      "use": "@vercel/static"
    },
    {
      "src": "schema.json",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "glossary/**",
      "use": "@vercel/static"
    },
    {
      "src": "writing/**",
      "use": "@vercel/static"
    }
  ]
}
